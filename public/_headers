# Zwischenspeicherung der unveraenderlichen Bauartefakte.
# Alles unter /_next/static/ traegt einen Pruefsummen-Namen und kann
# unbegrenzt zwischengespeichert werden.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Alles andere: nichts zwischenspeichern. Jede Seite haengt an ihrer Anmeldung.
/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
