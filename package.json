{
  "name": "e-mail-app",
  "version": "0.1.0",
  "private": true,
  "description": "DSGVO-konformer Mail-Assistent fuer die Kundenbetreuung einer deutschen Kaeserei",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vorschau": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "ausliefern": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "skills": "node skripte/skills-einlesen.mjs",
    "predev": "node skripte/skills-einlesen.mjs",
    "prebuild": "node skripte/skills-einlesen.mjs",
    "pretest": "node skripte/skills-einlesen.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
