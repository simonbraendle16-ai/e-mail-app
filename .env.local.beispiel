# Vorlage. Kopieren nach .env.local und ausfüllen.
# .env.local steht in .gitignore und wird nie eingecheckt.
# Die Klickfolge zum Beschaffen der Werte steht in SUPABASE-SETUP.md.

# --- Supabase, Region Central EU (Frankfurt) --------------------------------
# Darf in den Browser, geschuetzt durch Row-Level-Security:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Umgeht JEDE Zugriffsregel. Nur serverseitig, bei Cloudflare als Secret:
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# --- Mistral, EU-Endpunkt ---------------------------------------------------
# Erreicht den Browser nie. Alle Modellaufrufe laufen serverseitig.
MISTRAL_API_KEY=

# --- Adresse der App --------------------------------------------------------
# Wird fuer den Anmeldelink gebraucht. Lokal http://localhost:3000,
# spaeter die Cloudflare-Adresse.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 1: Design-Prototyp ohne Anmeldung ansehen. Faellt danach weg.
PROTOTYP_OFFEN=1

# --- Feldverschluesselung (Phase 2) ----------------------------------------
# Je 32 Byte, base64. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ACHTUNG: Gehen sie verloren, sind Kundenname, Firma und Ansprechpartner
# unwiederbringlich unlesbar. Sichere Kopie in den Passwortmanager.
# Bei Cloudflare als Secret hinterlegen, nicht als normale Variable.
DATEN_SCHLUESSEL=
# Getrennter Schluessel fuer den Suchindex ueber die verschluesselten Felder.
SUCH_SCHLUESSEL=
