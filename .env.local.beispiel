# Vorlage. Kopieren nach .env.local und ausfüllen.
# .env.local steht in .gitignore und wird nie eingecheckt.
# Die Klickfolge zum Beschaffen der Werte steht in SUPABASE-SETUP.md.

# --- Supabase, Region Central EU (Frankfurt) --------------------------------
# Darf in den Browser, geschuetzt durch Row-Level-Security:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Umgeht JEDE Zugriffsregel. Nur serverseitig, bei Cloudflare als Secret:
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# --- Mistral, EU-Endpunkt ---------------------------------------------------
# Erreicht den Browser nie. Alle Modellaufrufe laufen serverseitig.
MISTRAL_API_KEY=

# --- Adresse der App --------------------------------------------------------
# Wird fuer den Anmeldelink gebraucht. Lokal http://localhost:3000,
# spaeter die Cloudflare-Adresse.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NUR LOKAL: haengt die Anmeldung aus, damit man Bildschirme ansehen kann,
# ohne sich anzumelden. Steht das in einer ausgelieferten Umgebung, ist die
# ganze App fuer jeden offen. Deshalb hier bewusst auskommentiert -- wer es
# lokal braucht, setzt es von Hand in seiner eigenen .env.
# PROTOTYP_OFFEN=1

# --- Feldverschluesselung (Phase 2) ----------------------------------------
# Je 32 Byte, base64. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ACHTUNG: Gehen sie verloren, sind Kundenname, Firma und Ansprechpartner
# unwiederbringlich unlesbar. Sichere Kopie in den Passwortmanager.
# Bei Cloudflare als Secret hinterlegen, nicht als normale Variable.
DATEN_SCHLUESSEL=
# Getrennter Schluessel fuer den Suchindex ueber die verschluesselten Felder.
SUCH_SCHLUESSEL=

# --- Modellanbindung (Phase 3) ---------------------------------------------
# Welcher Anbieter laeuft: mistral (Vorgabe) oder lokal.
# 'lokal' spricht Ollama, LM Studio und alles OpenAI-kompatible.
MODELL_ANBIETER=mistral

# Modellnamen. Am 2026-08-21 gegen die laufende API geprueft.
# Feste Versionen statt -latest, damit sich das Modell nicht still aendert --
# die Rueckschrittspruefung (MODELL.md 6) setzt voraus, dass ein Wechsel
# ueberhaupt bemerkt wird.
# MISTRAL_MODELL_GROSS=mistral-large-2512
# MISTRAL_MODELL_KLEIN=mistral-small-2603
# MISTRAL_MODELL_EINBETTUNG=mistral-embed-2312
# MISTRAL_BASIS_ADRESSE=https://api.mistral.ai/v1

# Lokaler Anbieter, falls MODELL_ANBIETER=lokal:
# LOKAL_BASIS_ADRESSE=http://localhost:11434/v1
# LOKAL_MODELL_GROSS=mistral-small
# LOKAL_MODELL_KLEIN=mistral-small
# LOKAL_MODELL_EINBETTUNG=nomic-embed-text

# Warnschwelle fuer die Monatskosten in Euro. Vorgabe 25.
# KOSTEN_WARNSCHWELLE_EUR=25
